# Copiez ce fichier en .env (gitignoré) puis renseignez vos données personnelles.
# /!\ Les valeurs contenant des espaces doivent être entre guillemets (format shell).
# En CI (GitHub Pages / Cloudflare Pages), utilisez des secrets/variables d'environnement
# portant exactement les mêmes noms.
SITE_NAME="Perf IT"
SITE_URL="https://perfitcenter.fr"

# Données personnelles (ne jamais committer directement dans le code)
CONTACT_EMAIL="contact@exemple.fr"
CONTACT_ADDRESS="Adresse ligne 1
Code postal Ville"
CONTACT_PHONE_MAXIME="06 00 00 00 00"
CONTACT_PHONE_MAXIME_RAW="0600000000"
CONTACT_PHONE_ROMAIN="06 00 00 00 00"
CONTACT_PHONE_ROMAIN_RAW="0600000000"
CONTACT_SIRET=""

# Endpoint du formulaire de contact (ex. Formspree : https://formspree.io/f/xxxxx).
# Laisser vide : le formulaire ouvrira un brouillon mail (mailto:).
FORM_ENDPOINT=""

# Copiez ce fichier en .env (gitignoré) puis renseignez vos données.
# /!\ Les valeurs contenant des espaces doivent être entre guillemets (format shell).
# En CI (GitHub Pages / Cloudflare Pages), utilisez des secrets/variables d'environnement
# portant exactement les mêmes noms.
SITE_NAME="Perf IT"
SITE_URL="https://perfitcenter.fr"

# Coordonnées affichées sur le site (ne jamais committer directement dans le code)
CONTACT_EMAIL="contact@exemple.fr"
CONTACT_ADDRESS="Adresse ligne 1
Code postal Ville"
